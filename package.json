{
  "name": "oerem",
  "version": "0.1.0-beta.1",
  "description": "Library database agnostik berbasis Knex",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=12.17.0"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build",
    "gen:types": "ts-node scripts/generate-types.ts"
  },
  "keywords": ["orm", "knex", "database"],
  "author": "Nama Kamu <email@kamu.com>",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "sqlite3": "^5.1.7",
    "ts-morph": "^25.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "knex": "^3.2.9"
  },
  "peerDependencies": {
    "knex": "^3.2.9",
    "pg": "^8.0.0",
    "pg-native": ">=3.0.0",
    "sqlite3": "^5.0.0 || ^6.0.0",
    "mysql": "^2.18.0",
    "mysql2": "^3.0.0",
    "tedious": "^16.0.0 || ^17.0.0 || ^18.0.0",
    "oracledb": ">=6.0.0",
    "better-sqlite3": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "pg": { "optional": true },
    "pg-native": { "optional": true },
    "sqlite3": { "optional": true },
    "mysql": { "optional": true },
    "mysql2": { "optional": true },
    "tedious": { "optional": true },
    "oracledb": { "optional": true },
    "better-sqlite3": { "optional": true }
  }
}